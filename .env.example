# Copy to .env and adjust. Never commit .env.

# Path of the SQLite database file. In Docker this will point into a volume.
DATABASE_PATH=site-monitor.db

# Background checker: seconds between two rounds, per-request timeout (seconds),
# and maximum number of requests in flight at the same time.
CHECK_INTERVAL_SECONDS=30
CHECK_TIMEOUT_SECONDS=10
CHECK_CONCURRENCY=10
